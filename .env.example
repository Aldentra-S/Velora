# ==============================================================================
# Velora Monorepo — Environment Variables Template (.env.example)
# Biaya Proyek: Rp0
# PENTING: Jangan masukkan kredensial atau rahasia produksi ke dalam file ini.
# ==============================================================================

# ─── BACKEND CONFIGURATION (apps/backend/.env) ────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Koneksi Database PostgreSQL Lokal
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/velora_dev?schema=public"

# Rahasia Token JWT (Gunakan string acak aman minimal 32 karakter)
JWT_ACCESS_SECRET="generate_random_secure_access_secret_32_chars_minimum"
JWT_REFRESH_SECRET="generate_random_secure_refresh_secret_32_chars_minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── FRONTEND CONFIGURATION (apps/frontend/.env) ───────────────────────────────
VITE_API_BASE_URL="http://localhost:5000/api"
