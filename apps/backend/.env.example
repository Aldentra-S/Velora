# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Local PostgreSQL)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/velora_dev?schema=public"

# Authentication Secrets (JWT)
# Use secure random strings for production/development
JWT_ACCESS_SECRET="replace_with_secure_random_string_access_secret"
JWT_REFRESH_SECRET="replace_with_secure_random_string_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
